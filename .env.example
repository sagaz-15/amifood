# Configuracion del servidor AmiFood
# Copie este archivo como .env y ajuste los valores.

# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP
PORT=3000

# Secreto JWT (minimo 16 caracteres). OBLIGATORIO cambiarlo en produccion.
JWT_SECRET=amifood-dev-only-secret-change-me

# Vigencia del token
JWT_EXPIRES_IN=24h

# Base de datos SQLite (relativa a server/ o ruta absoluta)
DB_FILE=./data/amifood.db

# CORS: * o lista separada por comas
CORS_ORIGIN=*

# Cargar datos demo al iniciar si la base esta vacia
SEED_ON_START=true
