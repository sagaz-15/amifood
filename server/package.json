{
  "name": "amifood-server",
  "version": "2.0.0",
  "private": true,
  "description": "API REST del modulo de consulta de productos (RF04) de AmiFood - Arquitectura Hexagonal",
  "type": "module",
  "main": "src/main.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "seed": "node --env-file-if-exists=.env src/infrastructure/adapters/out/persistence/sqlite/seed-cli.ts",
    "seed:reset": "node --env-file-if-exists=.env src/infrastructure/adapters/out/persistence/sqlite/seed-cli.ts --reset",
    "test": "node --test tests/product-service.test.ts tests/auth-service.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "typescript": "^5.9.3"
  }
}
